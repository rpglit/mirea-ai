# Host port for the app (container listens on 8000)
APP_PORT=8080
# Structured JSON log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# SQLite sessions file (inside container, on the petri-data volume)
DB_PATH=/data/sessions.db
# Safety cap: abort reachability construction beyond this many markings
REACH_MAX_MARKINGS=50000
